<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.care.mybatis.BookingMapper">

    <resultMap id="bookingView"
               type="com.example.care.dto.Dtos$BookingView">

        <id property="id" column="id"/>

        <result property="customerName" column="customer_name"/>
        <result property="caregiverName" column="caregiver_name"/>
        <result property="serviceName" column="service_name"/>

        <result property="startAt" column="start_at"/>
        <result property="endAt" column="end_at"/>

        <result property="status" column="status"/>
        <result property="price" column="price"/>
        <result property="address" column="address"/>
        <result property="note" column="note"/>

    </resultMap>

    <select id="findVisible" resultMap="bookingView">

        SELECT
            b.id,
            customer.name AS customer_name,
            caregiver.name AS caregiver_name,
            service.name AS service_name,
            slot.start_at,
            slot.end_at,
            b.status,
            b.price,
            b.address,
            b.note

        FROM booking b

        JOIN user_account customer
          ON customer.id = b.customer_id

        JOIN care_service service
          ON service.id = b.service_id

        JOIN care_slot slot
          ON slot.id = b.slot_id

        JOIN user_account caregiver
          ON caregiver.id = slot.caregiver_id

        WHERE 1 = 1

        <choose>
            <when test="role == 'CUSTOMER'">
                AND b.customer_id = #{userId}
            </when>

            <when test="role == 'CAREGIVER'">
                AND slot.caregiver_id = #{userId}
            </when>

            <when test="role == 'ADMIN'">
                AND 1 = 1
            </when>

            <otherwise>
                AND 1 = 0
            </otherwise>
        </choose>

        <if test="from != null">
            AND slot.start_at &gt;= #{from}
        </if>

        <if test="to != null">
            AND slot.start_at &lt; #{to}
        </if>

        <if test="id != null">
            AND b.id = #{id}
        </if>

        ORDER BY slot.start_at, b.id

    </select>

</mapper>